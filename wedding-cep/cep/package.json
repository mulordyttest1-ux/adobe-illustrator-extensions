{
  "name": "wedding-scripter-cep",
  "version": "1.0.0",
  "description": "Wedding Scripter CEP Panel for Adobe Illustrator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.cjs",
    "watch": "node build.cjs --watch",
    "test": "node --test js/**/*.test.js debug_scripts/**/*.test.cjs",
    "test:watch": "node --test --watch js/**/*.test.js",
    "test:smoke:raw": "node debug_scripts/test_smoke.cjs",
    "test:smoke:2026raw": "node debug_scripts/test_smoke_2026.cjs",
    "test:smoke": "npm run test:smoke:2026",
    "test:smoke:2026": "npm run build && npm run test:smoke:2026raw",
    "test:e2e": "npm run test:smoke",
    "lint:raw": "eslint js/ --config eslint.config.mjs --ignore-pattern bundle.js --max-warnings 0",
    "lint:app": "node ../../scripts/ensure_nx_project_graph.cjs && npm run lint:raw",
    "lint": "npm run lint:app && npm run dep-check",
    "dep-check": "node scripts/check_architecture.cjs",
    "dep-graph": "depcruise js --include-only \"^js\" --output-type mermaid > dependency-graph.mmd"
  },
  "dependencies": {
    "@wedding/domain": "file:../../../libs/wedding/domain"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0"
  },
  "nx": {
    "tags": [
      "scope:app"
    ]
  }
}
